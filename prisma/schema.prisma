generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  MEMBER
  JURNALIS
  KOL
}

enum ArticleStatus {
  DRAFT
  PENDING_REVIEW
  NEEDS_REVISION
  PUBLISHED
  REJECTED
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}
enum TaskStatus {
  ACTIVE
  COMPLETED // Jika quota sudah terpenuhi
  CANCELLED
}

model User {
  id          String      @id @default(cuid())
  name        String
  email       String      @unique
  password    String
  role        Role        @default(MEMBER)
  isVerified  Boolean     @default(false)
  isSuspended Boolean     @default(false)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  otps        Otp[]
  articles    Article[]
  comments    Comment[]
  notifications Notification[] // <-- TAMBAHKAN INI

  // Relasi KOL
  kolWallet       KOLWallet?
  taskSubmissions TaskSubmission[]
  payoutRequests PayoutRequest[]
}

model Article {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  excerpt     String?
  content     String
  coverImage  String?       @db.LongText
  status      ArticleStatus @default(DRAFT)
  views       Int           @default(0)
  
  authorId    String
  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  
  tags        Tag[]         @relation("ArticleTags")
  comments    Comment[]
  notifications Notification[] // <-- TAMBAHKAN INI
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([authorId])
  @@index([categoryId])
}

// <-- TAMBAHKAN MODEL BARU INI DI BAGIAN BAWAH -->
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  articleId String?  // Opsional, jika notifikasi terkait artikel spesifik
  article   Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  
  type      String   // "revision", "success", "info"
  title     String
  message   String
  isRead    Boolean  @default(false)
  
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}
model Otp {
  id         String   @id @default(cuid())
  email      String
  code       String
  expiresAt  DateTime

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  articles    Article[]
}

model Tag {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  createdAt   DateTime  @default(now())
  
  articles    Article[] @relation("ArticleTags")
}


model Comment {
  id          String        @id @default(cuid())
  content     String
  status      CommentStatus @default(PENDING)
  
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  articleId   String
  article     Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([articleId])
  @@index([status])
}

model DailyTraffic {
  id        String   @id @default(cuid())
  date      DateTime @unique // Format: YYYY-MM-DD
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

// ... (model User, Article, dll tetap sama) ...

// Model Dompet Digital KOL
model KOLWallet {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountName String   // Nama pemilik rekening/DANA
  phoneNumber String   // Nomor HP DANA
  balance     Int      @default(0) // Saldo dalam Rupiah (misal: 50000)
  updatedAt   DateTime @updatedAt
}

model Task {
  id          String      @id @default(cuid())
  title       String      // Judul task (misal: "Buat Konten TikTok Edukasi")
  description String      // Detail pengerjaan
  reward      Int         // Bayaran per KOL (misal: 20000)
  quota       Int         // Kuota maksimal KOL (misal: 50)
  claimed     Int         @default(0) // Berapa KOL yang sudah mengambil/mengerjakan
  status      TaskStatus  @default(ACTIVE)
  createdAt   DateTime    @default(now())
  
  submissions TaskSubmission[]
}


model TaskSubmission {
  id          String           @id @default(cuid())
  taskId      String
  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kolId       String
  kol         User             @relation(fields: [kolId], references: [id], onDelete: Cascade)
  proofLink   String           // Link bukti (Google Drive, TikTok, Instagram, dll)
  status      SubmissionStatus @default(PENDING)
  feedback    String?          // Catatan dari Admin jika ditolak
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

enum SubmissionStatus {
  CLAIMED
  PENDING    // Menunggu review Admin
  APPROVED   // Disetujui, saldo masuk ke dompet KOL
  REJECTED   // Ditolak, perlu revisi
}

enum PayoutStatus {
  PENDING
  PAID
}

model PayoutRequest {
  id          String          @id @default(cuid())
  kolId       String
  kol         User            @relation(fields: [kolId], references: [id], onDelete: Cascade)
  amount      Int
  status      PayoutStatus    @default(PENDING)
  requestedAt DateTime        @default(now())
  processedAt DateTime?

  @@index([kolId])

}